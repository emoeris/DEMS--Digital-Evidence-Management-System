# Copy to .env and edit. NEVER commit .env.

# --- Core secrets ---------------------------------------------------------
# JWT signing secret (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-64-byte-urlsafe-random-string

# Passphrase used to derive the Key Encryption Key (KEK) via Argon2id.
# DEVELOPMENT ONLY. In production leave this EMPTY: the server then prompts
# for the passphrase at startup so it exists only in memory.
KEK_PASSPHRASE=change-me-use-a-long-dev-passphrase

# --- Runtime --------------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./dems.db
VAULT_PATH=./vault
KEY_CONFIG_PATH=./keyconfig.json

# --- Tokens (seconds) -----------------------------------------------------
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# --- CORS (comma separated, no wildcard) ----------------------------------
CORS_ORIGINS=https://localhost:5173,http://localhost:5173

# --- Phase 2B options (defaults shown) --------------------------------------
# Admin accounts must complete MFA before using the API. MUST be true in production.
REQUIRE_ADMIN_MFA=false
MAX_LOGIN_ATTEMPTS=5
UPLOAD_MAX_BYTES=2147483648
# Re-verify integrity before every download and refuse corrupted evidence.
VERIFY_BEFORE_DOWNLOAD=true
# Comma separated, "type/*" wildcards allowed. Narrow this for your organisation.
# ALLOWED_MIME_TYPES=image/*,application/pdf,text/plain
